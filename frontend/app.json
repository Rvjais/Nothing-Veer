{
  "expo": {
    "newArchEnabled": false,
    "name": "Veer Music",
    "slug": "veer-music",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/VeerMusicLogo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#D71921",
    "splash": {
      "image": "./assets/VeerMusicLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.veer.music",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/VeerMusicLogo.png",
        "monochromeImage": "./assets/VeerMusicLogo.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/VeerMusicLogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "abf0b411-0ce8-449b-8da5-65aa0dca8dd1"
      }
    }
  }
}